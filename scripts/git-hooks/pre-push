#!/bin/sh
# Refuses a push if a pushed commit has AI attribution lines, or an Anthropic author or committer.
# Rebase and cherry-pick skip commit-msg, so this is the last check.
zero=0000000000000000000000000000000000000000
bad='^co-authored-by:.*(claude|anthropic)|^claude-session:|generated with.*claude|^noreply@anthropic\.com$'
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    set -- "$local_sha" --not --remotes
  else
    set -- "$remote_sha..$local_sha"
  fi
  # A range git cannot read (remote hash not known here) is refused, never passed.
  if ! text=$(git log --format='%h%n%ae%n%ce%n%B' "$@" 2>&1); then
    echo "pre-push: cannot check $local_ref, push refused. Fetch and look first." >&2
    echo "$text" >&2
    exit 1
  fi
  hits=$(printf '%s\n' "$text" | grep -iE "$bad" || true)
  if [ -n "$hits" ]; then
    echo "pre-push: attribution line or author in $local_ref, push refused:" >&2
    echo "$hits" >&2
    exit 1
  fi
done
exit 0
